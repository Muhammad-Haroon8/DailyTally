{
  "pages": {
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/login/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/login/page.js"
    ],
    "/(dashboard)/shops/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(dashboard)/shops/page.css",
      "static/chunks/app/(dashboard)/shops/page.js"
    ],
    "/(dashboard)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(dashboard)/layout.js"
    ],
    "/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/page.js"
    ],
    "/(dashboard)/shops/[shopId]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(dashboard)/shops/[shopId]/page.css",
      "static/chunks/app/(dashboard)/shops/[shopId]/page.js"
    ],
    "/(dashboard)/customers/[customerId]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(dashboard)/customers/[customerId]/page.css",
      "static/chunks/app/(dashboard)/customers/[customerId]/page.js"
    ],
    "/(dashboard)/audit-log/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(dashboard)/audit-log/page.css",
      "static/chunks/app/(dashboard)/audit-log/page.js"
    ],
    "/_not-found/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/_not-found/page.js"
    ]
  }
}